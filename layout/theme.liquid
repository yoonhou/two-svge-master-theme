{% if request.page_type == 'product' %}
<script type="text/javascript">
(() => {
  window._learnq = window._learnq || [];

  // VIEWED PRODUCT METRIC
  const klaviyoItem = {
    Name: {{ product.title|json }},
    ProductID: {{ product.id|json }},
    Categories: {{ product.collections|map:'title'|json }},
    ImageURL: "https:{{ product.featured_image | image_url: width: 600 }}",
    URL: "{{ shop.secure_url }}{{ product.url }}",
    Brand: {{ product.vendor|json }},
    Price: {{ product.price|money|json }},
    CompareAtPrice: {{ product.compare_at_price_max|money|json }}
  };
  window._learnq.push(['track', 'Viewed Product', klaviyoItem]);
  window._learnq.push(['trackViewedItem', {
    Title: klaviyoItem.Name,
    ItemId: klaviyoItem.ProductID,
    Categories: klaviyoItem.Categories,
    ImageUrl: klaviyoItem.ImageURL,
    Url: klaviyoItem.URL,
    Metadata: {
      Brand: klaviyoItem.Brand,
      Price: klaviyoItem.Price,
      CompareAtPrice: klaviyoItem.CompareAtPrice
    }
  }]);


  // ADDED TO CART METRIC
  const addToCartBtns = document.querySelectorAll('[data-action="add-to-cart"]');

  const addToCart = () => {
    window._learnq.push(['track', 'Added to Cart', klaviyoItem]);
  };

  addToCartBtns.forEach(addToCartBtn => {
    addToCartBtn.addEventListener('click', addToCart, false);
  });
})();

</script>
{% endif %}

{% if request.page_type == 'page' %}
<script type="text/javascript">
window._learnq = window._learnq || [];
const pageUrl = window.location.href.split('?')[0];
window._learnq.push(['track', 'Viewed Page', {
  PageURL: pageUrl
}]);
</script>
{% endif %}

{% if request.page_type == 'collection' %}
<script type="text/javascript">
window._learnq = window._learnq || [];
const collectionPageUrl = window.location.href;
window._learnq.push(['track', 'Viewed Collection', {
  Collection: {{ collection.title|json }},
  PageURL: collectionPageUrl
}]);
</script>
{% endif %}
