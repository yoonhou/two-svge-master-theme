{%- assign collection_image = block.settings.image | default: collection.image | default: collection.products.first.featured_image -%}
{%- assign collection_image_alignment = block.settings.image_alignment | default: 'center center' -%}

{%- if collection_image -%}
  {%- assign collection_pocket_height = 500 -%}
  {%- assign collection_desktop_height = 600 -%}
  {%- case section.settings.image_size -%}
    {%- when 'small' -%}
      {%- assign collection_pocket_height = 450 -%}
      {%- assign collection_desktop_height = 500 -%}
    {%- when 'large' -%}
      {%- assign collection_pocket_height = 550 -%}
      {%- assign collection_desktop_height = 700 -%}
  {%- endcase -%}
  {%- assign collection_pocket_cover_width = collection_pocket_height | times: collection_image.aspect_ratio | ceil -%}
  {%- assign collection_desktop_cover_width = collection_desktop_height | times: collection_image.aspect_ratio | ceil -%}
  {%- capture supported_sizes -%}{%- render 'image-size', sizes: '240,320,400,480,560,640,750,900,1000,1080,1200,1500', image: collection_image -%}{%- endcapture -%}
  {%- assign image_widths = supported_sizes | split: ',' -%}
  {%- capture collection_image_srcset -%}
    {%- for image_width in image_widths -%}
      {{ collection_image | image_url: width: image_width | append: '&quality=75' }} {{ image_width }}w{% unless forloop.last %}, {% endunless %}
    {%- endfor -%}
  {%- endcapture -%}
  {%- assign collection_image_fallback_url = collection_image | image_url: width: 750 | append: '&quality=75' -%}
  {%- assign collection_image_noscript_url = collection_image | image_url: width: 1000 | append: '&quality=75' -%}
{%- endif -%}

<a href="{{ block.settings.button_link | default: collection.url }}" {{ block.shopify_attributes }} class="CollectionItem {% if section.settings.expand_collection %}CollectionItem--expand{% endif %} {% if template == 'index' %}Carousel__Cell {% if forloop.first %}is-selected{% endif %}{% endif %}" data-slide-index="{{ forloop.index0 }}">
  <div class="CollectionItem__Wrapper CollectionItem__Wrapper--{{ section.settings.image_size }}" {% if collection_image %}style="background-image: url({{ collection_image | image_url: width: 20 }})"{% endif %}>
    <div class="CollectionItem__ImageWrapper">
      <div class="CollectionItem__Image {% if apply_overlay %}Image--contrast{% endif %} Image--zoomOut Image--lazyLoaded hide-no-js">
        {%- if collection_image -%}
          <img class="CollectionItem__ResponsiveImage"
               src="{{ collection_image_fallback_url | escape }}"
               srcset="{{ collection_image_srcset | strip_newlines | escape }}"
               sizes="(max-width: 640px) max(calc(100vw - 48px), {{ collection_pocket_cover_width }}px), (max-width: 1139px) max(calc(50vw - 45px), {{ collection_pocket_cover_width }}px), max(calc(25vw - 38px), {{ collection_desktop_cover_width }}px)"
               alt=""
               width="{{ collection_image.width }}"
               height="{{ collection_image.height }}"
               loading="lazy"
               style="object-position: {{ collection_image_alignment }};">
        {%- else -%}
          <div class="PlaceholderBackground PlaceholderSvg--dark">
            {%- capture image_name -%}lifestyle-{% cycle 'anchor': '1', '2' %}{%- endcapture -%}
            {{ image_name | placeholder_svg_tag: 'PlaceholderBackground__Svg' }}
          </div>
        {%- endif -%}
      </div>

      {%- if collection_image -%}
        <noscript>
          <div class="CollectionItem__Image {% if apply_overlay %}Image--contrast{% endif %}" style="background-position: {{ collection_image_alignment }}; background-image: url({{ collection_image_noscript_url }})"></div>
        </noscript>
      {%- endif -%}
    </div>

    <div class="CollectionItem__Content CollectionItem__Content--{{ block.settings.content_position | default: 'bottomLeft' }}">
      <header class="SectionHeader">
        {%- if block.settings.subheading != blank -%}
          <h3 class="SectionHeader__SubHeading Heading u-h6">{{ block.settings.subheading | escape }}</h3>
        {%- endif -%}

        <h2 class="SectionHeader__Heading SectionHeader__Heading--emphasize Heading u-h1">{{ block.settings.title | default: collection.title | escape }}</h2>

        <div class="SectionHeader__ButtonWrapper">
          {%- if block.settings.button_text != blank -%}
            <span class="CollectionItem__Link Button">{{ block.settings.button_text | escape }}</span>
          {%- else -%}
            <span class="CollectionItem__Link Button">{{ 'collection.general.view_products' | t }}</span>
          {%- endif -%}
        </div>
      </header>
    </div>
  </div>
</a>
