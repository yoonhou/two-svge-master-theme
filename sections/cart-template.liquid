{%- capture section_settings -%}
{
"type": {{ settings.cart_type | json }},
"itemCount": {{ cart.item_count }},
"drawer": false,
"hasShippingEstimator": {% if section.settings.show_shipping_estimator and cart.item_count > 0 %}true{% else %}false{% endif %}
}
{%- endcapture -%}
{{ 'cart.css' | asset_url | stylesheet_tag }}
<section data-section-id="{{ section.id }}" data-section-type="cart" data-section-settings='{{ section_settings }}'>
{%- if cart.item_count == 0 -%}
<div class="EmptyState">
<div class="Container">
<h1 class="EmptyState__Title Heading u-h5">{{ 'cart.general.empty' | t }}</h1>

{%- if settings.cart_show_free_shipping_threshold -%}
{%- assign threshold_in_cents = settings.cart_free_shipping_threshold | times: 100 -%}
{%- capture remaining_amount -%}<span>{{ cart.total_price | minus: threshold_in_cents | abs | money_without_trailing_zeros }}</span>{%- endcapture -%}

<p class="Text--subdued">{{- 'cart.general.free_shipping_remaining_html' | t: remaining_amount: remaining_amount -}}</p>
{%- endif -%}

<a href="{{ routes.root_url }}" class="EmptyState__Action Button Button--primary">{{ 'cart.general.empty_button' | t }}</a>
</div>
</div>
{%- else -%}
<div class="Container">
<header class="PageHeader">
<div class="SectionHeader SectionHeader--center">
<h1 class="SectionHeader__Heading Heading u-h1">{{ 'cart.general.title' | t }}</h1>

{%- if settings.cart_show_free_shipping_threshold -%}
{%- assign threshold_in_cents = settings.cart_free_shipping_threshold | times: 100 -%}

<p class="SectionHeader__Description Text--subdued">
{%- if cart.total_price >= threshold_in_cents -%}
{{- 'cart.general.free_shipping' | t -}}
{%- else -%}
{%- capture remaining_amount -%}<span>{{ cart.total_price | minus: threshold_in_cents | abs | money_without_trailing_zeros }}</span>{%- endcapture -%}
{{- 'cart.general.free_shipping_remaining_html' | t: remaining_amount: remaining_amount -}}
{%- endif -%}
</p>
{%- endif -%}
</div>
</header>

<div class="PageContent">
<form action="{{ routes.cart_url }}" method="POST" class="Cart Cart--expanded" novalidate>
<input type="hidden" name="attributes[collection_mobile_items_per_row]" value="">
<input type="hidden" name="attributes[collection_desktop_items_per_row]" value="">

{% render 'cart-items' %}

<footer class="Cart__Footer">
{%- if settings.cart_enable_notes -%}
<div class="Cart__NoteContainer">
<span class="Cart__NoteButton">{{ 'cart.general.add_note' | t }}</span>
<textarea class="Cart__Note Form__Textarea" name="note" id="cart-note" rows="4" placeholder="{{ 'cart.general.note_placeholder' | t }}" aria-label="{{ 'cart.general.note_placeholder' | t }}">{{ cart.note | escape }}</textarea>
</div>
{%- endif -%}

<div class="Cart__Recap">
{%- capture shipping_and_taxes_notice -%}{{ 'cart.general.shipping_and_taxes_notice' | t }}{%- endcapture -%}

{%- if cart.cart_level_discount_applications != blank -%}
{%- for discount_application in cart.cart_level_discount_applications -%}
<p class="Cart__Discount Heading u-h6">{{ 'cart.general.discount' | t }} ({{ discount_application.title | escape }}): -<span>{{ discount_application.total_allocated_amount | money_without_trailing_zeros }}</span></p>
{%- endfor -%}
{%- endif -%}

<p class="Cart__Total Heading u-h6"><span id='revy-cart-subtotal-price'>{{ 'cart.general.total' | t }}: <span>{{ cart.total_price | money_without_trailing_zeros }}</span></span></p>

{%- if shipping_and_taxes_notice != blank -%}
<p class="Cart__Taxes Text--subdued">{{ shipping_and_taxes_notice }}</p>
{%- endif -%}

<button type="submit" name="checkout" class="Cart__Checkout Button Button--primary Button--full">{{ 'cart.general.checkout' | t }}</button>
{%- for block in section.blocks -%}
{%- case block.type -%}
{%- when 'bundle_card' -%}
{%- liquid
assign tn = 'xlr8d-product-03'
assign bundle_page_url = block.settings.bundle_page_url | default: '/pages/bundle'
assign bundle_items = 3
assign fallback_image_url = 'https://cdn.shopify.com/s/files/1/0083/8441/3756/files/ACC_TS_Product_03_3_Pack_Bundle_image_x360.png?v=1776328916'

if block.settings.cart_bundle_image != blank
assign bundle_image_url = block.settings.bundle_button_image | img_url: '180x180'
else
assign bundle_image_url = fallback_image_url
endif

assign bundle_title = block.settings.bundle_title | default: '3 pack bundle'
assign bundle_subtitle = block.settings.bundle_subtitle | default: 'Choose any 3 styles'
assign bundle_discount_prefix = block.settings.bundle_discount_prefix | default: 'save'
assign bundle_discount_value = block.settings.bundle_discount_value | default: '20%'

assign price_product = block.settings.bundle_price_product
if price_product == blank
assign price_product = all_products['intent-black']
endif

assign unit_price_cents = blank

if price_product != blank
assign unit_price_cents = price_product.price
if unit_price_cents > 0
assign regular_cents = unit_price_cents | times: bundle_items
assign discounted_cents = regular_cents | times: 80 | divided_by: 100
assign savings_cents = regular_cents | minus: discounted_cents
assign per_item_cents = discounted_cents | divided_by: bundle_items
endif
endif
-%}
<div class="bundle-cart-row">
<a
href='{{ bundle_page_url }}'
class='{{ tn }}_bundle'
data-{{ tn }}-bundle
>
<div class='{{ tn }}_bundle_inner'>
<div class='{{ tn }}_bundle_main'>
<div class='{{ tn }}_bundle_thumb'>
<img
    src='{{ bundle_image_url }}'
    alt='{{ bundle_title | escape }}'
    width='90'
    height='90'
    loading='lazy'
    decoding='async'
>
</div>
<div class='{{ tn }}_bundle_content'>
<div class='{{ tn }}_bundle_row1'>
    <div class='{{ tn }}_bundle_titles'>
        <div class='{{ tn }}_bundle_title'>{{ bundle_title }}</div>
        <div class='{{ tn }}_bundle_sub'>{{ bundle_subtitle }}</div>
    </div>
    <div class='{{ tn }}_bundle_peritem'>
        <div class='{{ tn }}_bundle_peritem_prefix'>from</div>
        <div class='{{ tn }}_bundle_peritem_price'>{{ per_item_cents | money }}</div>
        <div class='{{ tn }}_bundle_peritem_label'>per item</div>
    </div>
</div>
<div class='{{ tn }}_bundle_row2'>
    <div class='{{ tn }}_bundle_compare_row'>
        <span class='{{ tn }}_bundle_compare_prefix'>from</span>
        <span class='{{ tn }}_bundle_compare'>{{ regular_cents | money }}</span>
        <span class='{{ tn }}_bundle_sale'>{{ discounted_cents | money }}</span>
    </div>
    <span class='{{ tn }}_bundle_pill'>SAVE AT LEAST {{ savings_cents | money }}</span>
</div>
</div>
</div>
<div class='{{ tn }}_bundle_side' aria-hidden='true'>
<div class='{{ tn }}_bundle_side_save'>{{ bundle_discount_prefix }}</div>
<div class='{{ tn }}_bundle_side_pct'>{{ bundle_discount_value }}</div>
</div>
</div>
</a>
</div>


{{ 'xlr8d-product-03.css' | asset_url | stylesheet_tag }}

{%- endcase -%}
{%- endfor -%}
<a href="{{ routes.collections_url }}/sunglasses" title="Continue shopping" class="continue_shopping_button Cart__Checkout Button Button--secondary Button--full">Continue shopping</a>
</div>
</footer>
</form>

{%- if section.settings.show_shipping_estimator -%}
<div class="Section Section--spacingExtraLarge">
<div class="Panel">
<h2 class="Panel__Title Heading u-h2">{{ 'cart.shipping_estimator.title' | t }}</h2>

<div class="Panel__Content">
<div class="ShippingEstimator">
<div class="ShippingEstimator__Form">
<div class="ShippingEstimator__Country Form__Select Select Select--primary">
{%- render 'icon' with 'select-arrow' -%}
<select name="country" title="{{ 'cart.shipping_estimator.country' | t }}" data-default="{% if customer %}{{ customer.default_address.country | escape }}{% elsif section.settings.shipping_estimator_default_country != '' %}{{ section.settings.shipping_estimator_default_country | escape }}{% endif %}">{{ all_country_option_tags }}</select>
</div>

<div class="ShippingEstimator__Province Form__Select Select Select--primary" style="display: none">
{%- render 'icon' with 'select-arrow' -%}
<select name="province" title="{{ 'cart.shipping_estimator.province' | t }}"></select>
</div>

<input type="text" class="ShippingEstimator__Zip Form__Input" name="zip" placeholder="{{ 'cart.shipping_estimator.zip_code' | t }}" aria-label="{{ 'cart.shipping_estimator.zip_code' | t }}">

<button type="button" class="ShippingEstimator__Submit Button Button--primary">{{ 'cart.shipping_estimator.estimate' | t }}</button>
</div>

<div class="ShippingEstimator__Error Alert Alert--error" style="display: none"></div>
<div class="ShippingEstimator__Results">
<div class="ShippingEstimator__ResultsInner"></div>
</div>
</div>
</div>
</div>
</div>
{%- endif -%}
</div>
</div>
{%- endif -%}
</section>
<style>
#shopify-section-product-recommendations{
display: none;
}
</style>
{% schema %}
{
"name": "Cart page",
"class": "shopify-section--bordered",
"settings": [
{
"type": "checkbox",
"id": "show_shipping_estimator",
"label": "Show shipping rates calculator",
"default": true
},
{
"type": "text",
"id": "shipping_estimator_default_country",
"label": "Default country to use",
"info": "If your customer is logged-in, the country in his default shipping address will be selected.",
"default": "United States"
}
],
"blocks": [
{
"type": "bundle_card",
"name": "Bundle card",
"limit": 1,
"settings": [
{
"type": "checkbox",
"id": "cart_bundle_card_visible",
"label": "Hide cart bundle card",
"default": false
},
{
"type": "product",
"id": "bundle_price_product",
"label": "Bundle price product",
"info": "Base unit price for bundle math (×3, −20%). Falls back to 'intent-black' if empty."
},
{
"type": "url",
"id": "bundle_page_url",
"label": "Bundle page URL",
"info": "Defaults to /pages/bundle if empty."
},
{
"type": "image_picker",
"id": "bundle_button_image",
"label": "Bundle Button Image"
},
{
"type": "text",
"id": "bundle_title",
"label": "Bundle Button Title",
"default": "3 pack bundle"
},
{
"type": "text",
"id": "bundle_subtitle",
"label": "Bundle Button Sub Title",
"default": "Choose any 3 styles"
},
{
"type": "text",
"id": "bundle_discount_prefix",
"label": "Bundle Discount Prefix",
"default": "save"
},
{
"type": "text",
"id": "bundle_discount_value",
"label": "Bundle Discount Value",
"default": "20%"
}
]
}
]
}
{% endschema %}
