{% schema %}
{
  "name": "Bundle page",
  "settings": [{
    "type": "text",
    "id": "discount_code",
    "label": "Discount CODE"
  }],
  "blocks": [
    {
      "name": "Gallery slide",
      "type": "gallery_slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
