      }
      .next {
          position: absolute;
          right: 41px;
      }
      .previous{
          position: relative;
          left: 54px;
      }
  }
</style>

<section
  class="Product Product--{{ section.settings.image_size }}"
  data-section-id="{{ section.id }}"
  data-section-type="bundle-page"
  data-section-settings="{{ section.settings | json | escape }}"
>
  <div class="Product__Wrapper">
    <div class="container my-4">
      <div class="Product__Gallery  Product__Gallery--withThumbnails">
        <div
          class="carousel carousel-main Product__Slideshow"
          data-flickity='{"prevNextButtons": true ,"pageDots": true,"draggable": true,"resize": true }'
        >
          {%- for block in section.blocks -%}
            {%- if block.type == 'gallery_slide' -%}
              {%- assign slide_image = block.settings.image -%}
              {%- assign slide_url = block.settings.image_url -%}
              {%- assign slide_width = block.settings.image_width | default: slide_image.width -%}
              {%- assign slide_height = block.settings.image_height | default: slide_image.height -%}

              {%- if slide_image != blank -%}
                <img src="{{ slide_image | image_url: width: slide_image.width }}" width="{{ slide_image.width }}" height="{{ slide_image.height }}" alt="{{ block.settings.alt | escape }}" {{ block.shopify_attributes }}>
              {%- elsif slide_url != blank -%}
                <img src="{{ slide_url | escape }}" width="{{ slide_width }}" height="{{ slide_height }}" alt="{{ block.settings.alt | escape }}" {{ block.shopify_attributes }}>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
        <div class="Product__SlideshowNav Product__SlideshowNav--thumbnails">
          <div
            class="carousel carousel-nav Product__SlideshowNavScroller"
            data-flickity='{ "asNavFor": ".carousel-main", "contain": true, "pageDots": false ,"prevNextButtons": false }'
          >
            {%- for block in section.blocks -%}
              {%- if block.type == 'gallery_slide' -%}
                {%- assign thumbnail_image = block.settings.thumbnail_image | default: block.settings.image -%}
                {%- assign thumbnail_url = block.settings.thumbnail_image_url | default: block.settings.image_url -%}
                {%- assign thumbnail_width = block.settings.thumbnail_width | default: thumbnail_image.width -%}
                {%- assign thumbnail_height = block.settings.thumbnail_height | default: thumbnail_image.height -%}
                {%- assign thumbnail_alt = block.settings.thumbnail_alt | default: block.settings.alt -%}

                {%- if thumbnail_image != blank or thumbnail_url != blank -%}
                  <div class="Product__Slides-img">
                    {%- if thumbnail_image != blank -%}
                      <img
                        src="{{ thumbnail_image | image_url: width: thumbnail_image.width }}"
                        alt="{{ thumbnail_alt | escape }}"
                        width="{{ thumbnail_image.width }}"
                        height="{{ thumbnail_image.height }}"
                      >
                    {%- else -%}
                      <img
                        src="{{ thumbnail_url | escape }}"
                        alt="{{ thumbnail_alt | escape }}"
                        width="{{ thumbnail_width }}"
                        height="{{ thumbnail_height }}"
                      >
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="Product__InfoWrapper">
    <div class="Product__Info">
      <div class="Container">
        <div class="ProductMeta">
          <h1 class="ProductMeta__Title Heading u-h2">3-PACK bundle</h1>
          <div
            style=""
            class="jdgm-widget jdgm-preview-badge jdgm-preview-badge--with-link jdgm--done-setup"
            data-id="6759644758198"
            data-template="product"
            data-auto-install="false"
          >
            <div
              style="display:none"
              class="jdgm-prev-badge"
              data-average-rating="4.85"
              data-number-of-reviews="1037"
              data-number-of-questions="0"
            >
              <span
                class="jdgm-prev-badge__stars"
                data-score="4.85"
                tabindex="0"
                aria-label="4.85 stars"
                role="button"
              >
                <span class="jdgm-star jdgm--on"></span>
                <span class="jdgm-star jdgm--on"></span>
                <span class="jdgm-star jdgm--on"></span>
                <span class="jdgm-star jdgm--on"></span>
                <span class="jdgm-star jdgm--on"></span>
              </span>
              <span class="jdgm-prev-badge__text">1037 reviews</span>
            </div>
          </div>
        </div>
        <div class="ProductMeta__PriceList Heading">
          <span class="ProductMeta__Price Price Text--subdued u-h4">
            <span class="price-from">From </span>
            <span class="regular--price">$252</span>
            <span class="discount--price"> $201</span>
          </span>
        </div>
        <p class="afterpay-paragraph after-payment" style="opacity:0;">
          <span class="afterpay-main-text">Make 4 interest-free payments of <strong>$50.25</strong> with </span>
          <span class="afterpay-logo-link">
            <button
              onclick="document.querySelector('afterpay-modal').setAttribute('visible', 'visible')"
              class="afterpay-logo brand-afterpay compact-badge type-badge black-on-mint"
              aria-label="Afterpay logo - Opens a dialog"
